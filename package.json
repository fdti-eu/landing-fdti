{
	"name": "landing-page-fdti",
	"version": "1.0.0",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"check": "npm run check:i18n && npm run check:svelte",
		"check:i18n": "node scripts/check-i18n-parity.mjs",
		"check:svelte": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write ."
	},
	"devDependencies": {
		"@sveltejs/adapter-static": "^4.0.1",
		"@sveltejs/kit": "^3.4.0",
		"@sveltejs/vite-plugin-svelte": "^7.3.2",
		"@tailwindcss/typography": "^0.5.20",
		"@tailwindcss/vite": "^4.3.5",
		"@types/node": "^25.9.10",
		"@typescript-eslint/eslint-plugin": "^8.74.0",
		"@typescript-eslint/parser": "^8.74.0",
		"eslint": "^8.57.1",
		"eslint-config-prettier": "^9.1.0",
		"eslint-plugin-svelte": "^2.46.1",
		"prettier": "^3.10.1",
		"prettier-plugin-svelte": "^3.5.2",
		"svelte": "^5.59.1",
		"svelte-check": "^4.7.8",
		"svelte-eslint-parser": "^1.12.0",
		"tailwindcss": "^4.3.5",
		"tslib": "^2.9.1",
		"typescript": "^6.0.3",
		"vite": "^8.3.8"
	},
	"type": "module",
	"dependencies": {
		"svelte-i18n": "^4.0.1",
		"svelte-meta-tags": "^4.7.0"
	},
	"overrides": {
		"svelte-i18n": {
			"esbuild": "^0.25.12"
		}
	},
	"imports": {
		"#lib/*": "./src/lib/*",
		"#locales/*": "./src/locales/*"
	}
}
