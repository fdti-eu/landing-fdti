{
	"name": "landing-page-fdti",
	"version": "1.0.0",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"check": "npm run check:i18n && npm run check:svelte",
		"check:i18n": "node scripts/check-i18n-parity.mjs",
		"check:svelte": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write ."
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@sveltejs/adapter-static": "^4.0.1",
		"@sveltejs/kit": "^3.4.0",
		"@sveltejs/vite-plugin-svelte": "^7.3.2",
		"@tailwindcss/typography": "^0.5.20",
		"@tailwindcss/vite": "^4.3.5",
		"@types/node": "^24.19.2",
		"eslint": "^10.15.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.24.1",
		"globals": "^17.14.0",
		"prettier": "^3.10.1",
		"prettier-plugin-svelte": "^4.2.0",
		"svelte": "^5.59.1",
		"svelte-check": "^4.7.8",
		"tailwindcss": "^4.3.5",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.74.0",
		"vite": "^8.3.8"
	},
	"type": "module",
	"dependencies": {
		"svelte-i18n": "^4.0.1",
		"svelte-meta-tags": "^5.0.3"
	},
	"overrides": {
		"svelte-i18n": {
			"esbuild": "^0.25.12"
		},
		"@tailwindcss/typography": {
			"postcss-selector-parser": "^6.1.6"
		}
	},
	"imports": {
		"#lib/*": "./src/lib/*",
		"#locales/*": "./src/locales/*"
	}
}
